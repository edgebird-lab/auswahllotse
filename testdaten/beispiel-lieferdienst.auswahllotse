    {
      "id": "katalog:N-BT-2",
      "nummer": "B-02",
      "gruppe": "betrieb",
      "titel": "Datenherausgabe bei Vertragsende",
      "text": "Der Anbieter muss bei Vertragsende alle Daten und Belege vollständig in offenen, dokumentierten Formaten herausgeben. Frist und Kosten stehen im Vertrag.",
      "abnahme": "Probeexport aller Testdaten; die Vertragsklausel liegt vor.",
