    {
      "id": "katalog:N-GB-1",
      "nummer": "G-01",
      "gruppe": "ordnung",
      "titel": "Unveränderbarkeit gebuchter Daten",
      "text": "Die Software muss verhindern, dass gebuchte Daten ihren ursprünglichen Inhalt verlieren. Änderungen protokolliert sie mit Person und Zeitpunkt.",
      "abnahme": "Test: abgeschlossene Rechnung ändern; die Software verhindert es oder zeigt alten und neuen Wert.",
      "prioritaet": "muss",
      "prioritaetVorschlag": "muss",
      "status": "aktiv",
      "herkunft": {
        "art": "katalog",
        "bezuege": [],
        "katalogId": "N-GB-1"
      },
      "begruendung": "Katalog N-GB-1: gilt bei steuerlich wichtige Unterlagen.",
      "quelle": "§ 146 Abs. 4 AO, Stand 11.11.2026",
      "punkte": 0,
      "bearbeitet": {
        "text": false,
        "prioritaet": false,
        "status": false
      },
      "notiz": ""
    },
    {
      "id": "katalog:N-GB-2",
      "nummer": "G-02",
      "gruppe": "ordnung",
      "titel": "Aufbewahrung",
      "text": "Die Software muss Bücher 10 Jahre, Buchungsbelege 8 Jahre und Geschäftsbriefe 6 Jahre lesbar und maschinell auswertbar bereithalten, auch nach Vertragsende.",
      "abnahme": "Der Vertrag regelt Aufbewahrung und Herausgabe; ein Test-Export ist maschinell auswertbar.",
      "prioritaet": "muss",
      "prioritaetVorschlag": "muss",
      "status": "aktiv",
      "herkunft": {
        "art": "katalog",
        "bezuege": [],
        "katalogId": "N-GB-2"
      },
      "begruendung": "Katalog N-GB-2: gilt bei steuerlich wichtige Unterlagen.",
      "quelle": "§ 147 Abs. 2 und 3 AO, Stand 11.11.2026",
      "punkte": 0,
      "bearbeitet": {
        "text": false,
        "prioritaet": false,
        "status": false
      },
      "notiz": ""
    },
    {
      "id": "katalog:N-GB-3",
      "nummer": "G-03",
      "gruppe": "ordnung",
      "titel": "Datenzugriff der Finanzverwaltung",
      "text": "Die Software muss den Datenzugriff der Finanzverwaltung unterstützen: Einsicht, Auswertung nach Vorgabe und Übergabe in maschinell auswertbarem Format.",
      "abnahme": "Vorführung von Prüferzugang und Datenexport.",
      "prioritaet": "muss",
      "prioritaetVorschlag": "muss",
      "status": "aktiv",
      "herkunft": {
