    {
      "id": "katalog:N-BT-1",
      "nummer": "B-01",
      "gruppe": "betrieb",
      "titel": "Datensicherung und Wiederherstellung",
      "text": "Die Software muss mindestens täglich gesichert werden. Die Wiederherstellung gelingt binnen 24 Stunden und wird jährlich getestet.",
      "abnahme": "Sicherungskonzept und Protokoll eines Wiederherstellungstests liegen vor.",
