    {
      "id": "rollen",
      "nummer": "R-01",
      "gruppe": "benutzer",
      "titel": "Rollen und Rechte",
      "text": "Die Software muss 4 Rollen mit eigenen Rechten abbilden: Innendienst (4 Benutzer): „Bestellung in Warenwirtschaft erfassen“, „Bestellung ändern“ und „Bestellung stornieren“; Disposition (1 Benutzer): „Tour planen“ und „Zustellung im System bestätigen“; Buchhaltung (1 Benutzer): „Rechnung erstellen“ und „Rechnung versenden“; Niederlassungsleitung (1 Benutzer): „Rechnung freigeben“.",
      "abnahme": "Test: Jede Rolle erledigt ihre Aufgaben; Aufgaben anderer Rollen sind gesperrt.",
      "prioritaet": "muss",
      "prioritaetVorschlag": "muss",
      "status": "aktiv",
