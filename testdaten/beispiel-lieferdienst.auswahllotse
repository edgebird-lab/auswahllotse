    {
      "id": "katalog:N-GB-4",
      "nummer": "G-04",
      "gruppe": "ordnung",
      "titel": "Unterlagen für die Verfahrensdokumentation",
      "text": "Der Anbieter sollte Unterlagen für die Verfahrensdokumentation liefern: Systembeschreibung, Einstellungen, Schnittstellen, Datensicherung.",
      "abnahme": "Die Unterlagen liegen vor dem Echtbetrieb vor.",
