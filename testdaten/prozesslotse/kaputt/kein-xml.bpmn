  <bpmn:process id="Prozess" name="Bestellung bis Rechnung (Lieferdienst)" isExecutable="false">
    <bpmn:documentation>Ein regionaler Lieferdienst nimmt Bestellungen telefonisch an, liefert am Folgetag aus und stellt danach die Rechnung. · Vorgänge pro Arbeitstag: 120 · Arbeitstag: 8 Std.</bpmn:documentation>
    <bpmn:extensionElements>
      <pl:projekt xmlns:pl="https://olbricht-digital.de/prozesslotse/projekt" ansicht="ist" formatVersion="3">{"formatVersion":3,"ist":{"formatVersion":3,"id":"pro_lieferdienst","name":"Bestellung bis Rechnung (Lieferdienst)","beschreibung":"Ein regionaler Lieferdienst nimmt Bestellungen telefonisch an, liefert am Folgetag aus und stellt danach die Rechnung.","ausloeser":{"art":"nachricht","text":"Kunde bestellt telefonisch","von":"tln_kunde"},"ergebnis":"Ware zugestellt und berechnet","vorgaengeProTag":120,"arbeitsstundenProTag":8,"rollen":[{"id":"rol_innendienst","name":"Innendienst","stunden