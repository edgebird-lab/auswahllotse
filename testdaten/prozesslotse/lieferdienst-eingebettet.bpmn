<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitionen" targetNamespace="https://olbricht-digital.de/prozesslotse" exporter="Prozesslotse" exporterVersion="0.1.0">
  <bpmn:collaboration id="Kollaboration">
    <bpmn:participant id="Teilnehmer" name="Bestellung bis Rechnung (Lieferdienst)" processRef="Prozess" />
    <bpmn:participant id="Pool_tln_kunde" name="Kunde" />
    <bpmn:messageFlow id="Nachricht_1" sourceRef="Pool_tln_kunde" targetRef="Start" />
    <bpmn:messageFlow id="Nachricht_2" sourceRef="auf_benachrichtigen" targetRef="Pool_tln_kunde" />
    <bpmn:messageFlow id="Nachricht_3" sourceRef="Pool_tln_kunde" targetRef="wrt_termin" />
    <bpmn:messageFlow id="Nachricht_4" sourceRef="auf_versenden" targetRef="Pool_tln_kunde" />
  </bpmn:collaboration>
  <bpmn:process id="Prozess" name="Bestellung bis Rechnung (Lieferdienst)" isExecutable="false">
    <bpmn:documentation>Ein regionaler Lieferdienst nimmt Bestellungen telefonisch an, liefert am Folgetag aus und stellt danach die Rechnung. · Vorgänge pro Arbeitstag: 120 · Arbeitstag: 8 Std.</bpmn:documentation>
    <bpmn:extensionElements>
      <pl:projekt xmlns:pl="https://olbricht-digital.de/prozesslotse/projekt" ansicht="ist" formatVersion="3">{"formatVersion":3,"ist":{"formatVersion":3,"id":"pro_lieferdienst","name":"Bestellung bis Rechnung (Lieferdienst)","beschreibung":"Ein regionaler Lieferdienst nimmt Bestellungen telefonisch an, liefert am Folgetag aus und stellt danach die Rechnung.","ausloeser":{"art":"nachricht","text":"Kunde bestellt telefonisch","von":"tln_kunde"},"ergebnis":"Ware zugestellt und berechnet","vorgaengeProTag":120,"arbeitsstundenProTag":8,"rollen":[{"id":"rol_innendienst","name":"Innendienst","stundensatz":38,"personen":4,"verfuegbarProzent":100},{"id":"rol_lager","name":"Lager","stundensatz":34,"personen":5,"verfuegbarProzent":100},{"id":"rol_disposition","name":"Disposition","stundensatz":45,"personen":1,"verfuegbarProzent":100},{"id":"rol_fahrer","name":"Fahrer","stundensatz":32,"personen":6,"verfuegbarProzent":100},{"id":"rol_buchhaltung","name":"Buchhaltung","stundensatz":48,"personen":1,"verfuegbarProzent":60},{"id":"rol_leitung","name":"Niederlassungsleitung","stundensatz":65,"personen":1,"verfuegbarProzent":25}],"medien":[{"id":"med_papier","name":"Papier","art":"papier"},{"id":"med_telefon","name":"Telefon","art":"telefon"},{"id":"med_excel","name":"Excel-Tourenliste","art":"tabelle"},{"id":"med_erp","name":"Warenwirtschaft","art":"erp"}],"teilnehmer":[{"id":"tln_kunde","name":"Kunde"}],"ablauf":{"id":"haupt","schritte":[{"typ":"aufgabe","id":"auf_annehmen","name":"Bestellung telefonisch annehmen","rolleId":"rol_innendienst","mediumId":"med_papier","bearbeitungMin":6,"liegezeitMin":0,"art":"normal","freigabeQuote":0.9,"brauchtVorgaenger":null,"uebertragung":null},{"typ":"aufgabe","id":"auf_erfassen","name":"Bestellung in Warenwirtschaft erfassen","rolleId":"rol_innendienst","mediumId":"med_erp","bearbeitungMin":4,"liegezeitMin":90,"art":"normal","freigabeQuote":0.9,"brauchtVorgaenger":true,"uebertragung":{"quelleMediumId":"med_papier","minuten":3}},{"typ":"entscheidung","id":"ent_vorrat","art":"daten","frage":"Ware vorrätig?","zweige":[{"id":"zw_vorrat_ja","bezeichnung":"Ja","anteil":0.92,"schritte":[],"ende":null,"zurueckZu":null,"ereignis":null},{"id":"zw_vorrat_nein","bezeichnung":"Nein","anteil":0.08,"schritte":[{"typ":"aufgabe","id":"auf_ersatz","name":"Kunden anrufen und Ersatz anbieten","rolleId":"rol_innendienst","mediumId":"med_telefon","bearbeitungMin":5,"liegezeitMin":60,"art":"normal","freigabeQuote":0.9,"brauchtVorgaenger":true,"uebertragung":null},{"typ":"entscheidung","id":"ent_ersatz","art":"daten","frage":"Ersatz angenommen?","zweige":[{"id":"zw_ersatz_ja","bezeichnung":"Ja","anteil":0.7,"schritte":[{"typ":"aufgabe","id":"auf_aendern","name":"Bestellung ändern","rolleId":"rol_innendienst","mediumId":"med_erp","bearbeitungMin":3,"liegezeitMin":0,"art":"normal","freigabeQuote":0.9,"brauchtVorgaenger":true,"uebertragung":null}],"ende":null,"zurueckZu":null,"ereignis":null},{"id":"zw_ersatz_nein","bezeichnung":"Nein","anteil":0.3,"schritte":[{"typ":"aufgabe","id":"auf_stornieren","name":"Bestellung stornieren","rolleId":"rol_innendienst","mediumId":"med_erp","bearbeitungMin":2,"liegezeitMin":0,"art":"normal","freigabeQuote":0.9,"brauchtVorgaenger":true,"uebertragung":null}],"ende":"Bestellung storniert","zurueckZu":null,"ereignis":null}]}],"ende":null,"zurueckZu":null,"ereignis":null}]},{"typ":"wiederholung","id":"wdh_kommission","modus":"anteil","frage":"Fehler gefunden?","anteilWiederholung":0.2,"koerper":{"id":"seq_kommission","schritte":[{"typ":"aufgabe","id":"auf_kommissionieren","name":"Ware kommissionieren","rolleId":"rol_lager","mediumId":"med_papier","bearbeitungMin":8,"liegezeitMin":120,"art":"normal","freigabeQuote":0.9,"brauchtVorgaenger":null,"uebertragung":null},{"typ":"aufgabe","id":"auf_kontrollieren","name":"Kommissionierung kontrollieren","rolleId":"rol_lager","mediumId":"med_papier","bearbeitungMin":2,"liegezeitMin":15,"art":"pruefung","freigabeQuote":0.9,"brauchtVorgaenger":true,"uebertragung":null}]}},{"typ":"aufgabe","id":"auf_tour","name":"Tour planen","rolleId":"rol_disposition","mediumId":"med_excel","bearbeitungMin":1.5,"liegezeitMin":240,"art":"normal","freigabeQuote":0.9,"brauchtVorgaenger":false,"uebertragung":{"quelleMediumId":"med_erp","minuten":1}},{"typ":"aufgabe","id":"auf_verladen","name":"Ware verladen","rolleId":"rol_lager","mediumId":"med_papier","bearbeitungMin":3,"liegezeitMin":480,"art":"normal","freigabeQuote":0.9,"brauchtVorgaenger":true,"uebertragung":null},{"typ":"aufgabe","id":"auf_ausliefern","name":"Ware ausliefern","rolleId":"rol_fahrer","mediumId":"med_papier","bearbeitungMin":12,"liegezeitMin":180,"art":"normal","freigabeQuote":0.9,"brauchtVorgaenger":true,"uebertragung":null},{"typ":"entscheidung","id":"ent_angetroffen","art":"daten","frage":"Kunde angetroffen?","zweige":[{"id":"zw_angetroffen_ja","bezeichnung":"Ja","anteil":0.9,"schritte":[{"typ":"aufgabe","id":"auf_quittieren","name":"Empfang quittieren lassen","rolleId":"rol_fahrer","mediumId":"med_papier","bearbeitungMin":2,"liegezeitMin":0,"art":"normal","freigabeQuote":0.9,"brauchtVorgaenger":true,"uebertragung":null}],"ende":null,"zurueckZu":null,"ereignis":null},{"id":"zw_angetroffen_nein","bezeichnung":"Nein","anteil":0.1,"schritte":[{"typ":"aufgabe","id":"auf_benachrichtigen","name":"Benachrichtigung hinterlassen","rolleId":"rol_fahrer","mediumId":"med_papier","bearbeitungMin":1,"liegezeitMin":0,"art":"normal","freigabeQuote":0.9,"brauchtVorgaenger":true,"uebertragung":null,"nachrichtAn":"tln_kunde"},{"typ":"warten","id":"wrt_termin","name":"Neuen Liefertermin abwarten","art":"nachricht","dauerMin":480,"von":"tln_kunde"},{"typ":"aufgabe","id":"auf_erneut","name":"Ware erneut zustellen","rolleId":"rol_fahrer","mediumId":"med_papier","bearbeitungMin":12,"liegezeitMin":120,"art":"normal","freigabeQuote":0.9,"brauchtVorgaenger":true,"uebertragung":null}],"ende":null,"zurueckZu":null,"ereignis":null}]},{"typ":"aufgabe","id":"auf_abgeben","name":"Lieferscheine abgeben","rolleId":"rol_fahrer","mediumId":"med_papier","bearbeitungMin":1,"liegezeitMin":300,"art":"normal","freigabeQuote":0.9,"brauchtVorgaenger":true,"uebertragung":null},{"typ":"aufgabe","id":"auf_bestaetigen","name":"Zustellung im System bestätigen","rolleId":"rol_disposition","mediumId":"med_erp","bearbeitungMin":1.5,"liegezeitMin":240,"art":"normal","freigabeQuote":0.9,"brauchtVorgaenger":true,"uebertragung":{"quelleMediumId":"med_papier","minuten":1}},{"typ":"aufgabe","id":"auf_rechnung","name":"Rechnung erstellen","rolleId":"rol_buchhaltung","mediumId":"med_erp","bearbeitungMin":1.5,"liegezeitMin":480,"art":"normal","freigabeQuote":0.9,"brauchtVorgaenger":true,"uebertragung":null},{"typ":"aufgabe","id":"auf_freigeben","name":"Rechnung freigeben","rolleId":"rol_leitung","mediumId":"med_erp","bearbeitungMin":1,"liegezeitMin":960,"art":"freigabe","freigabeQuote":0.98,"brauchtVorgaenger":true,"uebertragung":null},{"typ":"aufgabe","id":"auf_versenden","name":"Rechnung versenden","rolleId":"rol_buchhaltung","mediumId":"med_erp","bearbeitungMin":0.5,"liegezeitMin":60,"art":"normal","freigabeQuote":0.9,"brauchtVorgaenger":true,"uebertragung":null,"nachrichtAn":"tln_kunde"}]}},"soll":null,"massnahmen":[],"verworfen":[]}</pl:projekt>
    </bpmn:extensionElements>
    <bpmn:laneSet id="Bahnen">
      <bpmn:lane id="Bahn_rol_innendienst" name="Innendienst">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>auf_annehmen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>auf_erfassen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ent_vorrat_auf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>auf_ersatz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ent_ersatz_auf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>auf_aendern</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>auf_stornieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>zw_ersatz_nein_ende</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ent_vorrat_zu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wdh_kommission_ein</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wdh_kommission_frage</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Bahn_rol_lager" name="Lager">
        <bpmn:flowNodeRef>auf_kommissionieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>auf_kontrollieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>auf_verladen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Bahn_rol_disposition" name="Disposition">
        <bpmn:flowNodeRef>auf_tour</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>auf_bestaetigen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Bahn_rol_fahrer" name="Fahrer">
        <bpmn:flowNodeRef>auf_ausliefern</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ent_angetroffen_auf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>auf_quittieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>auf_benachrichtigen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wrt_termin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>auf_erneut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ent_angetroffen_zu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>auf_abgeben</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Bahn_rol_buchhaltung" name="Buchhaltung">
        <bpmn:flowNodeRef>auf_rechnung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>auf_versenden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ende</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Bahn_rol_leitung" name="Niederlassungsleitung">
        <bpmn:flowNodeRef>auf_freigeben</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Kunde bestellt telefonisch">
      <bpmn:outgoing>Fluss_30</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_def" />
    </bpmn:startEvent>
    <bpmn:manualTask id="auf_annehmen" name="Bestellung telefonisch annehmen">
      <bpmn:documentation>Rolle: Innendienst · System: Papier · Bearbeitung: 6 Min. · Liegezeit davor: 0 Min.</bpmn:documentation>
      <bpmn:incoming>Fluss_30</bpmn:incoming>
      <bpmn:outgoing>Fluss_1</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="auf_erfassen" name="Bestellung in Warenwirtschaft erfassen">
      <bpmn:documentation>Rolle: Innendienst · System: Warenwirtschaft · Bearbeitung: 4 Min. · Liegezeit davor: 1,5 Std. · Medienbruch: Daten aus Papier von Hand übertragen (3 Min.)</bpmn:documentation>
      <bpmn:incoming>Fluss_1</bpmn:incoming>
      <bpmn:outgoing>Fluss_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ent_vorrat_auf" name="Ware vorrätig?" gatewayDirection="Diverging">
      <bpmn:incoming>Fluss_9</bpmn:incoming>
      <bpmn:outgoing>Fluss_6</bpmn:outgoing>
      <bpmn:outgoing>Fluss_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="auf_ersatz" name="Kunden anrufen und Ersatz anbieten">
      <bpmn:documentation>Rolle: Innendienst · System: Telefon · Bearbeitung: 5 Min. · Liegezeit davor: 1 Std.</bpmn:documentation>
      <bpmn:incoming>Fluss_6</bpmn:incoming>
      <bpmn:outgoing>Fluss_5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="ent_ersatz_auf" name="Ersatz angenommen?" gatewayDirection="Diverging">
      <bpmn:incoming>Fluss_5</bpmn:incoming>
      <bpmn:outgoing>Fluss_3</bpmn:outgoing>
      <bpmn:outgoing>Fluss_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="auf_aendern" name="Bestellung ändern">
      <bpmn:documentation>Rolle: Innendienst · System: Warenwirtschaft · Bearbeitung: 3 Min. · Liegezeit davor: 0 Min.</bpmn:documentation>
      <bpmn:incoming>Fluss_3</bpmn:incoming>
      <bpmn:outgoing>Fluss_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="auf_stornieren" name="Bestellung stornieren">
      <bpmn:documentation>Rolle: Innendienst · System: Warenwirtschaft · Bearbeitung: 2 Min. · Liegezeit davor: 0 Min.</bpmn:documentation>
      <bpmn:incoming>Fluss_4</bpmn:incoming>
      <bpmn:outgoing>Fluss_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="zw_ersatz_nein_ende" name="Bestellung storniert">
      <bpmn:incoming>Fluss_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="ent_vorrat_zu" gatewayDirection="Converging">
      <bpmn:incoming>Fluss_7</bpmn:incoming>
      <bpmn:incoming>Fluss_8</bpmn:incoming>
      <bpmn:outgoing>Fluss_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="wdh_kommission_ein" gatewayDirection="Converging">
      <bpmn:incoming>Fluss_13</bpmn:incoming>
      <bpmn:incoming>Fluss_14</bpmn:incoming>
      <bpmn:outgoing>Fluss_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="auf_kommissionieren" name="Ware kommissionieren">
      <bpmn:documentation>Rolle: Lager · System: Papier · Bearbeitung: 8 Min. · Liegezeit davor: 2 Std.</bpmn:documentation>
      <bpmn:incoming>Fluss_11</bpmn:incoming>
      <bpmn:outgoing>Fluss_10</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="auf_kontrollieren" name="Kommissionierung kontrollieren">
      <bpmn:documentation>Rolle: Lager · System: Papier · Bearbeitung: 2 Min. · Liegezeit davor: 15 Min. · Prüfung</bpmn:documentation>
      <bpmn:incoming>Fluss_10</bpmn:incoming>
      <bpmn:outgoing>Fluss_12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="wdh_kommission_frage" name="Fehler gefunden?" gatewayDirection="Diverging">
      <bpmn:incoming>Fluss_12</bpmn:incoming>
      <bpmn:outgoing>Fluss_13</bpmn:outgoing>
      <bpmn:outgoing>Fluss_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="auf_tour" name="Tour planen">
      <bpmn:documentation>Rolle: Disposition · System: Excel-Tourenliste · Bearbeitung: 1,5 Min. · Liegezeit davor: 4 Std. · Medienbruch: Daten aus Warenwirtschaft von Hand übertragen (1 Min.) · Braucht das Ergebnis des vorherigen Schritts nicht</bpmn:documentation>
      <bpmn:incoming>Fluss_15</bpmn:incoming>
      <bpmn:outgoing>Fluss_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="auf_verladen" name="Ware verladen">
      <bpmn:documentation>Rolle: Lager · System: Papier · Bearbeitung: 3 Min. · Liegezeit davor: 1 Arbeitstag</bpmn:documentation>
      <bpmn:incoming>Fluss_16</bpmn:incoming>
      <bpmn:outgoing>Fluss_17</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="auf_ausliefern" name="Ware ausliefern">
      <bpmn:documentation>Rolle: Fahrer · System: Papier · Bearbeitung: 12 Min. · Liegezeit davor: 3 Std.</bpmn:documentation>
      <bpmn:incoming>Fluss_17</bpmn:incoming>
      <bpmn:outgoing>Fluss_24</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="ent_angetroffen_auf" name="Kunde angetroffen?" gatewayDirection="Diverging">
      <bpmn:incoming>Fluss_24</bpmn:incoming>
      <bpmn:outgoing>Fluss_20</bpmn:outgoing>
      <bpmn:outgoing>Fluss_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="auf_quittieren" name="Empfang quittieren lassen">
      <bpmn:documentation>Rolle: Fahrer · System: Papier · Bearbeitung: 2 Min. · Liegezeit davor: 0 Min.</bpmn:documentation>
      <bpmn:incoming>Fluss_20</bpmn:incoming>
      <bpmn:outgoing>Fluss_22</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="auf_benachrichtigen" name="Benachrichtigung hinterlassen">
      <bpmn:documentation>Rolle: Fahrer · System: Papier · Bearbeitung: 1 Min. · Liegezeit davor: 0 Min.</bpmn:documentation>
      <bpmn:incoming>Fluss_21</bpmn:incoming>
      <bpmn:outgoing>Fluss_18</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:intermediateCatchEvent id="wrt_termin" name="Neuen Liefertermin abwarten">
      <bpmn:documentation>Wartezeit im Schnitt: 1 Arbeitstag</bpmn:documentation>
      <bpmn:incoming>Fluss_18</bpmn:incoming>
      <bpmn:outgoing>Fluss_19</bpmn:outgoing>
      <bpmn:messageEventDefinition id="wrt_termin_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="auf_erneut" name="Ware erneut zustellen">
      <bpmn:documentation>Rolle: Fahrer · System: Papier · Bearbeitung: 12 Min. · Liegezeit davor: 2 Std.</bpmn:documentation>
      <bpmn:incoming>Fluss_19</bpmn:incoming>
      <bpmn:outgoing>Fluss_23</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="ent_angetroffen_zu" gatewayDirection="Converging">
      <bpmn:incoming>Fluss_22</bpmn:incoming>
      <bpmn:incoming>Fluss_23</bpmn:incoming>
      <bpmn:outgoing>Fluss_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="auf_abgeben" name="Lieferscheine abgeben">
      <bpmn:documentation>Rolle: Fahrer · System: Papier · Bearbeitung: 1 Min. · Liegezeit davor: 5 Std.</bpmn:documentation>
      <bpmn:incoming>Fluss_25</bpmn:incoming>
      <bpmn:outgoing>Fluss_26</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="auf_bestaetigen" name="Zustellung im System bestätigen">
      <bpmn:documentation>Rolle: Disposition · System: Warenwirtschaft · Bearbeitung: 1,5 Min. · Liegezeit davor: 4 Std. · Medienbruch: Daten aus Papier von Hand übertragen (1 Min.)</bpmn:documentation>
      <bpmn:incoming>Fluss_26</bpmn:incoming>
      <bpmn:outgoing>Fluss_27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="auf_rechnung" name="Rechnung erstellen">
      <bpmn:documentation>Rolle: Buchhaltung · System: Warenwirtschaft · Bearbeitung: 1,5 Min. · Liegezeit davor: 1 Arbeitstag</bpmn:documentation>
      <bpmn:incoming>Fluss_27</bpmn:incoming>
      <bpmn:outgoing>Fluss_28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="auf_freigeben" name="Rechnung freigeben">
      <bpmn:documentation>Rolle: Niederlassungsleitung · System: Warenwirtschaft · Bearbeitung: 1 Min. · Liegezeit davor: 2 Arbeitstage · Freigabe, erteilt in 98 % der Fälle</bpmn:documentation>
      <bpmn:incoming>Fluss_28</bpmn:incoming>
      <bpmn:outgoing>Fluss_29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="auf_versenden" name="Rechnung versenden">
      <bpmn:documentation>Rolle: Buchhaltung · System: Warenwirtschaft · Bearbeitung: 0,5 Min. · Liegezeit davor: 1 Std.</bpmn:documentation>
      <bpmn:incoming>Fluss_29</bpmn:incoming>
      <bpmn:outgoing>Fluss_31</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Ende" name="Ware zugestellt und berechnet">
      <bpmn:incoming>Fluss_31</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Fluss_1" sourceRef="auf_annehmen" targetRef="auf_erfassen" />
    <bpmn:sequenceFlow id="Fluss_6" name="Nein" sourceRef="ent_vorrat_auf" targetRef="auf_ersatz">
      <bpmn:documentation>Anteil: 8 %</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluss_3" name="Ja" sourceRef="ent_ersatz_auf" targetRef="auf_aendern">
